# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ----- Forge connection -----
# 127.0.0.1:7860 is the default port for Forge Neo
# You can find the port in the Forge Neo settings
# If you are using a differente inference server, you can change it
FORGE_URL=http://127.0.0.1:7860

# Credentials for Forge's --api-auth flag.
# Leave blank (or omit) if you launched Forge without --api-auth.
FORGE_API_USER=
FORGE_API_PASSWORD=

# ----- Output -----
# Directory where generated images are saved (created automatically).
# If unset, defaults to ~/.cache/forge-painter/outputs (cross-platform).
OUTPUT_DIR=C:\path\to\your\outputs

# When enabled (1/true/yes/on), each generated image is saved to a
# timestamped auto path instead of overwriting the same file.
# Path: <OUTPUT_DIR>/<year>/<YYYY-MM-DD>/<YYYYMMDD_HHMMSS>_<ms3>_<counter5>.png
AUTO_SAVE=0

# ----- Generation defaults (env-overridable) -----
# These apply to txt2img and are the base for img2img/inpaint below.
DEFAULT_WIDTH=512
DEFAULT_HEIGHT=512
DEFAULT_SEED=-1
DEFAULT_BATCH_SIZE=1
DEFAULT_STEPS=9
DEFAULT_CFG_SCALE=1.0

# img2img / inpaint override steps, cfg_scale and sampler.
# Each inherits the txt2img default unless overridden here.
# IMG2IMG_STEPS=20
# IMG2IMG_CFG_SCALE=7.0
# IMG2IMG_SAMPLER=Euler a
# INPAINT_STEPS=20
# INPAINT_CFG_SCALE=7.0
# INPAINT_SAMPLER=Euler a

# img2img / inpaint denoising strength and inpaint mask controls.
# IMG2IMG_DENOISING_STRENGTH=0.6
# INPAINT_DENOISING_STRENGTH=0.75
# INPAINT_MASK_BLUR=4
# INPAINT_FILL=1

# upscale default multiplier.
# UPSCALE_RESIZE=2.0

# Leave empty (or omit) to keep the parameter "not specified".
# DEFAULT_SAMPLER=Euler a
# DEFAULT_SAVE_PATH=output.png

# Default negative prompt, applied when a tool call passes
# use_default_negative_prompt="1"/"true"/"yes"/"on" and no explicit negative_prompt.
# DEFAULT_NEGATIVE_PROMPT=blurry, lowres, bad anatomy

# ----- Request logbook -----
# Directory where the request logbook is stored. Defaults to OUTPUT_DIR.
LOG_DIR=C:\path\to\your\outputs

# Maximum number of entries kept in the logbook (default 100).
LOG_MAX_ENTRIES=100

# ----- Timeouts (seconds) -----
TIMEOUT_GENERATION=300
TIMEOUT_MODEL_SWITCH=120
TIMEOUT_INFO=30
TIMEOUT_CONTROL=10
